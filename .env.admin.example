# Только ручная подготовка/миграции. НЕ использовать как окружение сервиса LMS.
# Реальный файл вне Git, например /etc/slot-design-lms/admin.env; root:root 0600.
LMS_MODE=supabase
APP_ORIGIN=https://lms.example.org
DATABASE_URL=postgresql://postgres.PROJECT:REPLACE_DB_PASSWORD@SUPABASE_POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_ANON_KEY=REPLACE_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_SERVER_SERVICE_KEY
SUPABASE_STORAGE_BUCKET=lms-homework
LMS_RUNTIME_DIR=/var/lib/slot-design-lms
