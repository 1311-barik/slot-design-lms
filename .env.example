# Только шаблон. Реальные значения хранить вне workspace, например /etc/slot-design-lms/env.
LMS_MODE=supabase
# Только origin: HTTPS, без завершающего / и пути. Совпадает с адресом в браузере.
APP_ORIGIN=https://lms.example.org
DATABASE_URL=postgresql://lms_backend.PROJECT:REPLACE_PASSWORD@SUPABASE_POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_ANON_KEY=REPLACE_PUBLIC_ANON_KEY
# Нужны только для серверного файлового адаптера. Не отправлять в браузер.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_SERVER_SERVICE_KEY
SUPABASE_STORAGE_BUCKET=lms-homework
CLAMAV_SOCKET=/var/run/clamav/clamd.ctl
LMS_RUNTIME_DIR=/var/lib/slot-design-lms
# Почта курса отключена до проверки SMTP и очереди. Обработчик: npm run mail (отдельный процесс).
# Первое приглашение и повторные ссылки входа отправляет этот же SMTP через почтовый обработчик LMS.
MAIL_PROVIDER=
MAIL_FROM=lms@example.org
MAIL_FROM_NAME=Slot Design
# Пример Google Workspace. Провайдер определяется владельцем установки; сначала проверить SMTP.
# MAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=sender@example.org
# SMTP_PASSWORD=REPLACE_APP_PASSWORD
# MAIL_FROM=sender@example.org
