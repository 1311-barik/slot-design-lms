# Только шаблон. Реальные значения хранить вне workspace, например /etc/slot-design-lms/env.
LMS_MODE=supabase
APP_ORIGIN=https://lms.example.org
DATABASE_URL=postgresql://SERVER_DATABASE_USER:REPLACE_PASSWORD@SUPABASE_DATABASE_HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_ANON_KEY=REPLACE_PUBLIC_ANON_KEY
# Нужны только для серверного файлового адаптера. Не отправлять в браузер.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_SERVER_SERVICE_KEY
SUPABASE_STORAGE_BUCKET=lms-homework
LMS_RUNTIME_DIR=/var/lib/slot-design-lms
# Почта курса (LMS-11). Провайдер ещё не выбран; Brevo — кандидат. Обработчик: npm run mail (отдельный процесс).
# Входные ссылки в рабочей среде отправляет Supabase Auth через свой SMTP — это отдельная настройка.
MAIL_PROVIDER=brevo
BREVO_API_KEY=REPLACE_SERVER_KEY
MAIL_FROM=lms@example.org
MAIL_FROM_NAME=Slot Design
# Вариант 31.10.2026: корпоративный Google Workspace через SMTP (пароль приложения, не пароль аккаунта).
# MAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=sender@example.org
# SMTP_PASSWORD=REPLACE_APP_PASSWORD
# MAIL_FROM=sender@example.org
