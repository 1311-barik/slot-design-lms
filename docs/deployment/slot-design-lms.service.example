# Шаблон. Пользователь lms, пути и файл окружения должны быть созданы отдельно.
[Unit]
Description=Slot Design LMS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lms
Group=lms
WorkingDirectory=/opt/slot-design-lms/current
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
EnvironmentFile=/etc/slot-design-lms/env
# Node 24 установлен отдельно от системного Node других приложений.
ExecStart=/opt/slot-design-node-v24.15.0/bin/node scripts/next.mjs start --hostname 127.0.0.1 --port 8787
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/slot-design-lms/current/.next/cache /var/lib/slot-design-lms
UMask=0077

[Install]
WantedBy=multi-user.target
