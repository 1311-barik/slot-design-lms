# Шаблон для отдельного согласованного домена. Не заменяет существующие сайты Hetzner.
# Добавлять только после настройки TLS и выполнения production gates из architecture.md.
server {
    listen 443 ssl;
    server_name lms.example.org;
    ssl_certificate /etc/letsencrypt/live/lms.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/lms.example.org/privkey.pem;
    client_max_body_size 51m;
    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 90s;
        proxy_buffering off;
    }
}
