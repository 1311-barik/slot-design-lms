{
  "name": "slot-design-lms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "node scripts/next.mjs dev --webpack --hostname 127.0.0.1 --port 8787",
    "build": "node scripts/next.mjs build --webpack",
    "start": "node scripts/next.mjs start --hostname 127.0.0.1 --port 8787",
    "typecheck": "node scripts/next.mjs typegen && tsc --noEmit",
    "test": "sh scripts/test.sh tests/*.test.ts",
    "db:setup": "node --import tsx scripts/setup-db.ts",
    "mail": "node --import tsx scripts/mail-worker.ts",
    "supabase:setup": "node --import tsx scripts/supabase-setup.ts",
    "db:migrate": "node --import tsx scripts/migrate-production.ts",
    "deploy:check": "node --import tsx scripts/check-deployment.ts",
    "db:tool": "node --import tsx scripts/db-tool.ts"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "postgres": "3.4.7",
    "zod": "4.6.6",
    "fflate": "0.8.3",
    "sharp": "0.35.5",
    "nodemailer": "10.1.4"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.23.12",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@types/nodemailer": "8.0.2"
  }
}
